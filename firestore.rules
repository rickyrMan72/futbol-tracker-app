rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() {
      return (request.auth != null && request.auth.token.email == 'aquinogaona@gmail.com') || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isClaimable() {
      return !('ownerId' in resource.data) || resource.data.ownerId == null || resource.data.ownerId == '';
    }
    
    function isTeamOwner(equipoId) {
      return get(/databases/$(database)/documents/equipos/$(equipoId)).data.ownerId == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    match /equipos/{equipoId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || isClaimable());
      allow delete: if isSignedIn() && isValidId(equipoId) && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() 
                    && isValidId(equipoId) 
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.nombre is string;
      allow update: if isSignedIn() 
                    && isValidId(equipoId)
                    && (
                      isAdmin()
                      || ( resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId )
                      || ( isClaimable() && request.resource.data.ownerId == request.auth.uid )
                    );
    }

    match /jugadores/{jugadorId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || isClaimable());
      allow delete: if isSignedIn() && isValidId(jugadorId) && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(jugadorId) 
                    && request.resource.data.ownerId == request.auth.uid
                    && (isAdmin() || isTeamOwner(request.resource.data.equipoId));
      allow update: if isSignedIn() 
                    && isValidId(jugadorId)
                    && (
                      isAdmin()
                      || ( resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId )
                      || ( isClaimable() && request.resource.data.ownerId == request.auth.uid )
                    );
    }

    match /ejercicios/{ejercicioId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || isClaimable());
      allow delete: if isSignedIn() && isValidId(ejercicioId) && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(ejercicioId) 
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() 
                    && isValidId(ejercicioId)
                    && (
                      isAdmin()
                      || ( resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId )
                      || ( isClaimable() && request.resource.data.ownerId == request.auth.uid )
                    );
    }

    match /sesiones/{sesionId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || isClaimable());
      allow delete: if isSignedIn() && isValidId(sesionId) && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(sesionId) 
                    && request.resource.data.ownerId == request.auth.uid
                    && (isAdmin() || isTeamOwner(request.resource.data.equipoId));
      allow update: if isSignedIn() 
                    && isValidId(sesionId)
                    && (
                      isAdmin()
                      || ( resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId )
                      || ( isClaimable() && request.resource.data.ownerId == request.auth.uid )
                    );
    }

    match /partidos/{partidoId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || isClaimable());
      allow delete: if isSignedIn() && isValidId(partidoId) && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(partidoId) 
                    && request.resource.data.ownerId == request.auth.uid
                    && (isAdmin() || isTeamOwner(request.resource.data.equipoId));
      allow update: if isSignedIn() 
                    && isValidId(partidoId)
                    && (
                      isAdmin()
                      || ( resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId )
                      || ( isClaimable() && request.resource.data.ownerId == request.auth.uid )
                    );

      match /efemerides/{efemerideId} {
        allow read: if isSignedIn() && isValidId(partidoId) && (isAdmin() || get(/databases/$(database)/documents/partidos/$(partidoId)).data.ownerId == request.auth.uid || !('ownerId' in get(/databases/$(database)/documents/partidos/$(partidoId)).data));
        allow delete: if isSignedIn() && isValidId(partidoId) && isValidId(efemerideId)
                            && (isAdmin() || get(/databases/$(database)/documents/partidos/$(partidoId)).data.ownerId == request.auth.uid);
        allow list: if isSignedIn() && isValidId(partidoId);
        allow create: if isSignedIn() && isValidId(partidoId) && isValidId(efemerideId)
                            && (isAdmin() || get(/databases/$(database)/documents/partidos/$(partidoId)).data.ownerId == request.auth.uid || !('ownerId' in get(/databases/$(database)/documents/partidos/$(partidoId)).data));
        allow update: if isSignedIn() && isValidId(partidoId) && isValidId(efemerideId)
                            && (
                              isAdmin()
                              || get(/databases/$(database)/documents/partidos/$(partidoId)).data.ownerId == request.auth.uid 
                              || !('ownerId' in get(/databases/$(database)/documents/partidos/$(partidoId)).data)
                            );
      }
    }

    match /jugadas/{jugadaId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || isClaimable());
      allow delete: if isSignedIn() && isValidId(jugadaId) && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(jugadaId) 
                    && request.resource.data.ownerId == request.auth.uid
                    && (isAdmin() || isTeamOwner(request.resource.data.equipoId));
      allow update: if isSignedIn() 
                    && isValidId(jugadaId)
                    && (
                      isAdmin()
                      || ( resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId )
                      || ( isClaimable() && request.resource.data.ownerId == request.auth.uid )
                    );
    }
  }
}
